# Tallyn Environment Variables Template (.env.example)

# -------------------------------------------------------------
# Frontend Client Variables (Vite bundles variables starting with VITE_)
# -------------------------------------------------------------
# Supabase Project URL (Format: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase "Publishable" / "Anon" API Key
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Optional: OpenAI-compatible base URL used by the in-app Tallyn AI drawer
VITE_AI_BASE_URL=https://api.electronhub.ai/v1

# -------------------------------------------------------------
# Server & Edge Function Secrets (Never expose in client bundles)
# -------------------------------------------------------------
# Supabase "Secret" / "Service Role" Key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key

# Google AI Studio API Key (Gemini 3.7 Flash)
GEMINI_API_KEY=your-gemini-api-key
