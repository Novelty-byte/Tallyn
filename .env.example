# Tallyn Environment Variables Template (.env.example)

# -------------------------------------------------------------
# Frontend Client Variables (Vite bundles variables starting with VITE_)
# -------------------------------------------------------------
# Supabase Project URL (Format: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase "Publishable" / "Anon" API Key
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# NEVER put an AI key in a VITE_ variable: Vite copies VITE_* values into the
# public JavaScript bundle. AI keys live only in Supabase Edge Function secrets.

# -------------------------------------------------------------
# Server & Edge Function Secrets (Never expose in client bundles)
# -------------------------------------------------------------
# Supabase "Secret" / "Service Role" Key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key

# AI key — set as Supabase Edge Function SECRETS (Dashboard → Edge Functions → Secrets),
# used by the bill-scan and ai-gateway functions. Listed here only for local testing.
# Gemini key from Google AI Studio. A key starting "AIza" calls Gemini's native API; any
# other key goes to the OpenAI-compatible endpoint AI_BASE_URL (default: Google's own,
# https://generativelanguage.googleapis.com/v1beta/openai/).
# Tallyn uses apinex.bond (free/gemini-3.8-flash, ~15 requests/min). For Google instead:
#   GEMINI_MODEL=models/gemini-3.5-flash  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your-api-key
GEMINI_MODEL=free/gemini-3.8-flash
AI_BASE_URL=https://api.apinex.bond/v1

# Backup AI via OpenRouter: tried in order when the primary fails (out of credit, rate-limited,
# down, or an unusable reply). Only the key is needed; the models below are the defaults.
OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free
